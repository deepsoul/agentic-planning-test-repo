{
  "mcpServers": {
    "agentic-planning": {
      "command": "npm",
      "args": [
        "run",
        "mcp:dev",
        "--prefix",
        "/ABSOLUTER/PFAD/ZU/agentic-sprint/mein-agenten-board"
      ],
      "env": {
        "DASHBOARD_URL": "https://agentic-sprint-planning.vercel.app",
        "MCP_API_TOKEN": "DEIN_MCP_API_TOKEN"
      }
    }
  }
}
